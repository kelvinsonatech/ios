// Copy to Secrets.xcconfig. xcconfig treats "//" as a comment, so URLs use $() to break it up.
SUPABASE_URL = https:/$()/your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-key
// Optional: leave empty to hide Google sign-in. Must also be enabled in Supabase Auth providers.
GOOGLE_AUTH_ENABLED = NO
// StoreKit product identifiers (comma separated) configured in App Store Connect.
STOREKIT_PRODUCT_IDS = com.lumenlearning.premium.monthly,com.lumenlearning.premium.yearly
DEVELOPMENT_TEAM =
