# ---- Core -------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Vaultline

DATABASE_URL=postgres://vaultline:vaultline@localhost:5432/vaultline
REDIS_URL=redis://localhost:6379

# Encryption keyring for secrets at rest (node API tokens, MFA secrets, one-time results).
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEYS=k1:REPLACE_WITH_32_BYTE_BASE64_KEY
APP_ENCRYPTION_ACTIVE_KEY=k1
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=REPLACE_WITH_RANDOM_HEX_AT_LEAST_32_CHARS

# ---- Admin sessions -----------------------------------------------------------
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Number of reverse proxies in front of the app that append X-Forwarded-For (1 = Caddy/nginx).
# Never expose the Next.js port directly to the internet, or client IPs can be spoofed.
TRUSTED_PROXY_HOPS=1
# Comma-separated extra origins for Server Actions when behind a proxy that rewrites Host.
SERVER_ACTIONS_ALLOWED_ORIGINS=

# ---- VPN node communication ---------------------------------------------------
NODE_CONNECT_TIMEOUT_MS=5000
NODE_REQUEST_TIMEOUT_MS=15000
NODE_PROVISION_TIMEOUT_MS=45000
NODE_MAX_RESPONSE_BYTES=1048576
NODE_AGENT_LATEST_VERSION=1.0.0
# Development only: allow http:// node APIs and private/loopback node addresses (mock node).
ALLOW_INSECURE_NODE_HTTP=false
ALLOW_PRIVATE_NODE_ADDRESSES=false

# ---- Provisioning ---------------------------------------------------------------
PROVISION_RESULT_TTL_SECONDS=3600
PROVISION_MAX_ATTEMPTS=3

# ---- docker-compose ---------------------------------------------------------------
# Used by docker-compose.yml (DATABASE_URL/REDIS_URL are set there automatically).
POSTGRES_PASSWORD=change-me
SITE_DOMAIN=vpn.example.com
