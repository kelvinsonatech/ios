# Use this file instead of deploy/Caddyfile when the domain is proxied by Cloudflare (orange cloud).
# In .env set:  CADDYFILE=./deploy/Caddyfile.cloudflare  and  TRUSTED_PROXY_HOPS=2
#
# Only Cloudflare's own addresses may pass the visitor's IP on (X-Forwarded-For). A request that
# reaches this server directly, bypassing Cloudflare, has its X-Forwarded-For replaced, so client IPs
# cannot be spoofed. Ranges from https://www.cloudflare.com/ips (checked 2026-10-15); compare them
# with that page once in a while.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}
